generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  TRAINEE
  TRAINER
  ADMIN
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum CourseStatus {
  DRAFT
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum MaterialType {
  VIDEO
  PDF
  PRESENTATION
  OTHER
}

enum EnrollmentStatus {
  ENROLLED
  IN_PROGRESS
  COMPLETED
}

enum AnnouncementType {
  NOTIFICATION
  ACHIEVEMENT
  NEW_CONTENT
}

model User {
  id             String         @id @default(cuid())
  name           String
  email          String         @unique
  password       String
  role           Role
  approvalStatus ApprovalStatus @default(PENDING)
  createdAt      DateTime       @default(now())

  traineeProfile  TraineeProfile?
  trainerProfile  TrainerProfile?
  coursesCreated  Course[]           @relation("CourseTrainer")
  enrollments     Enrollment[]
  questionnaires  Questionnaire[]    @relation("QuestionnaireTrainer")
  attempts        AssessmentAttempt[]
  feedbacks       CourseFeedback[]
  announcements   Announcement[]
  competencyMaps  CompetencyMap[]
  certificates    Certificate[]
}

model TraineeProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  qualifications  String?
  workExperience  String?
  interests       String[]
  skills          String[]
  phone           String?
  certificateUrls String[]
  updatedAt       DateTime @updatedAt
}

model TrainerProfile {
  id               String   @id @default(cuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bio              String?
  subjectAreas     String[]
  yearsExperience  Int?
  phone            String?
  updatedAt        DateTime @updatedAt
}

model Course {
  id          String       @id @default(cuid())
  title       String
  description String
  subjectTag  String
  trainerId   String
  trainer     User         @relation("CourseTrainer", fields: [trainerId], references: [id])
  startDate   DateTime
  endDate     DateTime
  status      CourseStatus @default(DRAFT)
  createdAt   DateTime     @default(now())

  materials      CourseMaterial[]
  enrollments    Enrollment[]
  questionnaires Questionnaire[]
  feedbacks      CourseFeedback[]
  certificates   Certificate[]
}

model CourseMaterial {
  id         String       @id @default(cuid())
  courseId   String
  course     Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title      String
  type       MaterialType
  fileUrl    String
  uploadedAt DateTime     @default(now())
}

model Enrollment {
  id             String           @id @default(cuid())
  traineeId      String
  trainee        User             @relation(fields: [traineeId], references: [id], onDelete: Cascade)
  courseId       String
  course         Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  status         EnrollmentStatus @default(ENROLLED)
  progressPercent Int             @default(0)
  enrolledAt     DateTime         @default(now())
  completionDate DateTime?

  @@unique([traineeId, courseId])
}

model Questionnaire {
  id        String   @id @default(cuid())
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  trainerId String
  trainer   User     @relation("QuestionnaireTrainer", fields: [trainerId], references: [id])
  title     String
  deadline  DateTime
  createdAt DateTime @default(now())

  questions Question[]
  attempts  AssessmentAttempt[]
}

model Question {
  id              String        @id @default(cuid())
  questionnaireId String
  questionnaire   Questionnaire @relation(fields: [questionnaireId], references: [id], onDelete: Cascade)
  questionText    String
  options         String[]
  correctOption   Int
  subjectTag      String
}

model AssessmentAttempt {
  id              String        @id @default(cuid())
  traineeId       String
  trainee         User          @relation(fields: [traineeId], references: [id], onDelete: Cascade)
  questionnaireId String
  questionnaire   Questionnaire @relation(fields: [questionnaireId], references: [id], onDelete: Cascade)
  score           Float
  answers         Int[]
  submittedAt     DateTime      @default(now())

  @@unique([traineeId, questionnaireId])
}

model CourseFeedback {
  id        String   @id @default(cuid())
  traineeId String
  trainee   User     @relation(fields: [traineeId], references: [id], onDelete: Cascade)
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  rating    Int
  comments  String?
  createdAt DateTime @default(now())

  @@unique([traineeId, courseId])
}

model Announcement {
  id        String           @id @default(cuid())
  postedById String
  postedBy  User             @relation(fields: [postedById], references: [id])
  title     String
  body      String
  type      AnnouncementType
  postedAt  DateTime         @default(now())
}

model CompetencyMap {
  id               String @id @default(cuid())
  subjectTag       String
  trainerId        String
  trainer          User   @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  proficiencyScore Float
  rationale        String?

  @@unique([subjectTag, trainerId])
}

model Certificate {
  id                String   @id @default(cuid())
  traineeId         String
  trainee           User     @relation(fields: [traineeId], references: [id], onDelete: Cascade)
  courseId          String?
  course            Course?  @relation(fields: [courseId], references: [id])
  title             String
  issuer            String
  issueDate         DateTime @default(now())
  certificateUrl    String?
  verificationToken String   @unique @default(cuid())
  isPublic          Boolean  @default(true)
}
